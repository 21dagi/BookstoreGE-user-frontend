# Backend API Base URL
VITE_API_BASE_URL=https://api.gedame-eyesus.com/v1

# Enable/Disable Mock Services Layer (true = in-memory typed mocks, false = live backend API)
VITE_USE_MOCKS=true

# Application Metadata
VITE_APP_NAME=Gedame Eyesus Bookstore & Equb
VITE_TELEGRAM_BOT_USERNAME=GedameEyesusBot

# Development Tools
VITE_ENABLE_DEV_TOOLS=true
